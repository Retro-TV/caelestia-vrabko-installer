# Maintainer: Retro-TV
pkgname=libcava
pkgver=1.0.0
pkgrel=1
pkgdesc='Cava shared library used by Caelestia Shell'
arch=('x86_64')
url='https://github.com/LukashonakV/cava'
license=('MIT')
depends=('fftw' 'ncurses' 'alsa-lib' 'iniparser' 'libglvnd' 'sdl2' 'portaudio' 'sndio'
         'libpulse' 'libpipewire')
makedepends=('cmake' 'meson' 'autoconf-archive')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz")
sha256sums=('437df0a29e52e555357a06238f4c5cbe6d51b5dd4225700cb7adbb19d8bb9474')

build() {
    cd "cava-$pkgver"
    meson setup -Dcava_font=false --prefix=/usr build
    meson compile -C build
}

package() {
    cd "$srcdir/cava-$pkgver"
    DESTDIR="$pkgdir" meson install -C build
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
