# Maintainer: Retro-TV
pkgname=caelestia-cli-aw
pkgver=1.1.2.aw1.1.3
pkgrel=2
pkgdesc='Caelestia CLI with pinned animated wallpaper support'
arch=('any')
url='https://github.com/AdiAmbassador/caelestia-cli-aw'
license=('GPL-3.0-only')
depends=('python' 'python-pillow' 'python-materialyoucolor' 'libnotify' 'swappy' 'grim' 'dart-sass'
         'wl-clipboard' 'slurp' 'gpu-screen-recorder' 'dconf' 'cliphist' 'fuzzel' 'git' 'ffmpeg')
optdepends=('caelestia-shell: shell control and screenshot functionality')
makedepends=('python-build' 'python-installer' 'python-hatch' 'python-hatch-vcs')
provides=('caelestia-cli=1.1.2')
conflicts=('caelestia-cli' 'caelestia-cli-git')
options=('!debug')
_commit=cac4c534d57774e51b46412ca362437c038350ff
_archive="caelestia-cli-aw-${_commit}"
source=("${_archive}.tar.gz::${url}/archive/${_commit}.tar.gz"
        '0001-cli-install-state.patch::https://github.com/caelestia-dots/cli/commit/2a4094ff14bf19565735395a502d8b80ecb12e19.patch'
        '0002-cli-provider-state.patch::https://github.com/caelestia-dots/cli/commit/0a3a4bb0f915f596c4e18e4ca3b00a6b2064442b.patch'
        '0003-cli-pinned-dots.patch')
sha256sums=('5505e4c8ba86685ab709c603d4b4243317b150095a9f9a70544d1243c7a80bfc'
            '3f1ebdbfffa2a78d71af992a8c8a77a9418ebeeba9406d8368b098110b89f7fb'
            'bd46e831d2a9a79c1efa971bbed907b7c06a6f8ef0565d785b04c669944e3b9b'
            'de5f5082d76a1d4d9a71466fba743231125e95428f5546a3a731f4138ea11e41')

prepare() {
    cd "$srcdir/$_archive"
    patch -Np1 <"$srcdir/0001-cli-install-state.patch"
    patch -Np1 <"$srcdir/0002-cli-provider-state.patch"
    patch -Np1 <"$srcdir/0003-cli-pinned-dots.patch"
}

build() {
    cd "$srcdir/$_archive"
    SETUPTOOLS_SCM_PRETEND_VERSION='1.1.2+aw.1.1.3' python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/$_archive"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 completions/caelestia.fish "$pkgdir/usr/share/fish/vendor_completions.d/caelestia.fish"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
